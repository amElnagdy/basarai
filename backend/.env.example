# Supabase (database, storage, vault — NOT auth)
# Local:  http://127.0.0.1:54321 (via `supabase start`)
# Hosted: https://<project-ref>.supabase.co (from dashboard → Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=your-secret-key-here

# Clerk (auth) — dashboard → API Keys; Frontend API host is under "Advanced"
# CLERK_SECRET_KEY is read by the Next.js server (same container, same --env-file)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_ISSUER=https://<frontend-api-host>.clerk.accounts.dev
# Comma-separated browser origins allowed as `azp` (Docker: 3001, npm run dev: 3000, prod HTTPS origin)
CLERK_AUTHORIZED_PARTIES=http://localhost:3001,http://localhost:3000

# Storage Configuration
STORAGE_BUCKET=brand-assets

# Admin Configuration
ADMIN_EMAILS=admin@example.com

# CORS Configuration
# Comma-separated list of allowed origins (must match the host:port you expose)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost

# Server Configuration (local dev only; Docker uses BACKEND_HOST/BACKEND_PORT)
HOST=127.0.0.1
PORT=8000
